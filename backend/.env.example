# Skill Nexus Backend - Environment Variables
# Copy this file to .env and fill in the values.
# On Render: set these in the Environment tab of your web service.

# REQUIRED - JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-32-char-string

# OPTIONAL - Database URL.
# Leave blank to use SQLite (data resets on Render free-tier redeploys).
# For persistent storage, use a PostgreSQL URL from Render free DB:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
